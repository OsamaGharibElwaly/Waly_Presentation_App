{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run PyQt App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/frontend/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
